{
  "ruleset": "survivor-pension",
  "version": 1,
  "label": "Survivor (family) pension rules v1 (mock, based on Rule 4.10)",
  "effective_from": "2016-04-07",
  "thresholds": {"t_auto": 0.95, "t_human": 0.70, "cost_wrong_approval": 20, "cost_delay": 1},
  "rules": [
    {"id": "R0a_in_family_record", "title": "Claimant must be in the deceased's family record (FRC)", "basis": "FRC required for family pension",
     "require": [{"fact": "frc_links_claimant", "op": "is_true"}], "on_fail": "not_eligible", "reason": "NOT_IN_FAMILY_RECORD"},
    {"id": "R0b_death_verified", "title": "Death must be confirmed by the death registry", "basis": "Death certificate required",
     "require": [{"fact": "death_verified", "op": "is_true"}], "on_fail": "not_eligible", "reason": "DEATH_NOT_VERIFIED"},
    {"id": "R0c_pension_found", "title": "Deceased must be a registered pensioner", "basis": "Family pension follows the deceased's pension",
     "require": [{"fact": "pension_found", "op": "is_true"}], "on_fail": "not_eligible", "reason": "NO_PENSION_RECORD"},
    {"id": "R1_children_after_widow", "title": "Children qualify only if no eligible widow remains", "basis": "Rule 4.10(2)(A): widow first",
     "applies_if": [{"fact": "relation", "op": "in", "value": ["son", "daughter"]}],
     "require": [{"fact": "spouse_alive_eligible", "op": "is_false"}], "on_fail": "not_eligible", "reason": "WIDOW_FIRST"},
    {"id": "R2_share_split", "kind": "share", "title": "Share: equal split up to 4 people, else each widow 1/4", "basis": "Rule 4.10(2)(A)(i)(b) (we use the 'n <= 4' reading)",
     "max_equal_split": 4},
    {"id": "R3_son_age", "title": "Son must be 21 or under, unless disabled", "basis": "Federal O.M. 1(13)-Reg.6/83 para 8(2)(a)(ii) (Sindh text says 25)",
     "applies_if": [{"fact": "relation", "op": "eq", "value": "son"}],
     "require": [{"any_of": [{"fact": "claimant_age", "op": "lte", "value": 21}, {"fact": "claimant_disabled", "op": "is_true"}]}],
     "on_fail": "not_eligible", "reason": "CHILD_OVER_AGE"},
    {"id": "R4_daughter_status", "title": "Daughter must be unmarried, widowed or divorced (divorce date irrelevant)", "basis": "Supreme Court, 30 Jul 2025",
     "applies_if": [{"fact": "relation", "op": "eq", "value": "daughter"}],
     "require": [{"fact": "claimant_marital_status", "op": "in", "value": ["unmarried", "widowed", "divorced"]}],
     "on_fail": "not_eligible", "reason": "DAUGHTER_MARRIED"},
    {"id": "R5a_death_certificate", "title": "Death certificate required", "basis": "Pension claim forms",
     "require": [{"fact": "documents", "op": "contains", "value": "death_certificate"}], "on_fail": "missing_info", "reason": "MISSING_DEATH_CERT", "missing_item": "death_certificate"},
    {"id": "R5b_claimant_cnic", "title": "Claimant CNIC required", "basis": "Pension claim forms",
     "require": [{"fact": "documents", "op": "contains", "value": "claimant_cnic"}], "on_fail": "missing_info", "reason": "MISSING_INFO", "missing_item": "claimant_cnic"},
    {"id": "R5c_frc", "title": "Family registration certificate required", "basis": "Pension claim forms",
     "require": [{"fact": "documents", "op": "contains", "value": "frc"}], "on_fail": "missing_info", "reason": "MISSING_INFO", "missing_item": "frc"},
    {"id": "R5d_nikah_nama", "title": "Nikah nama required for a widow", "basis": "Widow pension forms",
     "applies_if": [{"fact": "relation", "op": "eq", "value": "widow"}],
     "require": [{"fact": "documents", "op": "contains", "value": "nikah_nama"}], "on_fail": "missing_info", "reason": "MISSING_INFO", "missing_item": "nikah_nama"},
    {"id": "R6_single_pension", "title": "Only one family pension per person", "basis": "Federal rule (Business Recorder, 27 Jun 2024)",
     "require": [{"fact": "already_draws_family_pension", "op": "is_false"}], "on_fail": "not_eligible", "reason": "ALREADY_DRAWING"}
  ]
}

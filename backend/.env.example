# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://sahara:sahara@localhost:5432/sahara
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=generate-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]
# Proxies in front of the API that append to X-Forwarded-For (0 locally; start.sh defaults to 1 for Railway).
RATE_LIMIT_PROXY_HOPS=0
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=2.0
# Optional Azure AI services (leave empty to use the free fallbacks: Tesseract OCR, browser speech).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
# Optional second independent sensor (Azure OpenAI chat deployment, e.g. gpt-4o-mini). Blank = disabled.
SECOND_SENSOR_ENDPOINT=
SECOND_SENSOR_KEY=
SECOND_SENSOR_DEPLOYMENT=
SECOND_SENSOR_API_VERSION=

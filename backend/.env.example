# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://sahara:sahara@localhost:5432/sahara
REDIS_URL=redis://:sahara-local@localhost:6379/0
JWT_SECRET=generate-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=2.0
# Optional Azure AI services (leave empty to use the free fallbacks: Tesseract OCR, browser speech).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# --- Production hardening (ENVIRONMENT=production turns these on) ---
# Judge-console shortcuts (demo reset, mock faults, skip payout hold) need header
# X-Demo-Console-Token equal to this. Unset in production = console disabled.
DEMO_CONSOLE_TOKEN=
# Production only: set true to expose /docs and /openapi.json.
ALLOW_DOCS=false
# Proxies whose X-Forwarded-For is trusted (IPs or CIDRs, comma-separated). Used by start.sh and the rate limiter.
FORWARDED_ALLOW_IPS=127.0.0.1
# Rate-limit storage; empty = Redis (REDIS_URL) in production, memory elsewhere.
RATELIMIT_STORAGE_URI=
# Request body cap in bytes (default 10 MB).
MAX_BODY_BYTES=10485760
# Demo account PINs (4-8 digits). Locally all default to 1234. In production all three are
# required and admin/officer must differ from 1234 and from DEMO_PIN.
DEMO_PIN=
DEMO_ADMIN_PIN=
DEMO_OFFICER_PIN=

# nginx substitutes ${PORT} and ${API_ORIGIN} at container start (official image template feature).
# nginx drops server-level add_header in any location that sets its own add_header, so every
# location includes the same security headers file (security-headers.inc, also templated).
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 1m;  # static site: nothing to upload here (the API is a separate service)
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    # Service worker and HTML must never be cached, or users get stuck on old versions.
    location = /sw.js { include /etc/nginx/conf.d/security-headers.inc; add_header Cache-Control "no-cache" always; try_files $uri =404; }
    location = /index.html { include /etc/nginx/conf.d/security-headers.inc; add_header Cache-Control "no-cache" always; }
    location /assets/ { include /etc/nginx/conf.d/security-headers.inc; add_header Cache-Control "public, max-age=31536000, immutable" always; }

    # Single-page app: unknown paths serve index.html.
    location / { try_files $uri $uri/ /index.html; }
}
